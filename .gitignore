# Environment
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Test and type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*

# Project artifacts and reports
# (newman output is already covered under artifacts/<workspace>/<collection>/<execution>/newman/)
artifacts/
reports/

# Backups locais de Collections (dados sensíveis: podem conter auth/tokens
# preservados integralmente da Collection original — nunca versionar)
backups/
*.backup.json
*_original_collection.json

# Editors
# Escopado só pra raiz (/.vscode/) porque extension/.vscode/ guarda
# launch.json/tasks.json versionados de propósito (config de debug da
# extensão, não preferência pessoal de editor).
/.vscode/
.idea/

# Arquivos locais de trabalho (não versionados)
/local/

# Extensão VSCode (extension/) — código TS é versionado, build/deps não.
extension/node_modules/
extension/out/
extension/*.vsix
# Binário de VSCode baixado pelo @vscode/test-electron para os testes de
# integração (extension/src/test/) — grande, regenerável, nunca versionar.
extension/.vscode-test/
# Wheels são binários grandes e regeneráveis por extension/scripts/prepare-release.ps1
# — nunca versionar. manifest.json (texto pequeno, documenta o que foi
# empacotado na última release) é versionado normalmente, sem regra aqui.
extension/resources/python-dist/*.whl
